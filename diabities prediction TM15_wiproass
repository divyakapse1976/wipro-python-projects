# ============================================================
# PROJECT: DIABETES PREDICTION
# Exploratory Data Analysis
# Dataset: Diabetes.csv
# ============================================================

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns


# ------------------------------------------------------------
# 1. LOAD THE DATA IN THE DATAFRAME
# ------------------------------------------------------------

df = pd.read_csv("Diabetes.csv")

print("First 5 rows:")
print(df.head())

print("\nDataset shape:")
print(df.shape)

print("\nDataset information:")
print(df.info())

print("\nStatistical summary:")
print(df.describe())


# ------------------------------------------------------------
# 2. DATA PRE-PROCESSING
# ------------------------------------------------------------

print("\nMissing values:")
print(df.isnull().sum())

# Remove duplicate records
df = df.drop_duplicates()

# Replace inappropriate zero values with NaN
columns_with_zero = [
    "Glucose",
    "BloodPressure",
    "SkinThickness",
    "Insulin",
    "BMI"
]

for column in columns_with_zero:
    if column in df.columns:
        df[column] = df[column].replace(0, np.nan)

# Fill missing numerical values with median
for column in columns_with_zero:
    if column in df.columns:
        df[column] = df[column].fillna(df[column].median())

print("\nMissing values after preprocessing:")
print(df.isnull().sum())


# ------------------------------------------------------------
# 3. HANDLE CATEGORICAL DATA
# ------------------------------------------------------------

# Outcome is the categorical target variable
if "Outcome" in df.columns:
    print("\nOutcome value counts:")
    print(df["Outcome"].value_counts())

    print("\nOutcome percentages:")
    print(df["Outcome"].value_counts(normalize=True) * 100)


# ------------------------------------------------------------
# 4. UNI-VARIATE ANALYSIS
# ------------------------------------------------------------

# Histograms for numerical columns
numeric_columns = df.select_dtypes(include=np.number).columns

for column in numeric_columns:
    plt.figure(figsize=(7, 4))
    sns.histplot(df[column], kde=True)
    plt.title("Distribution of " + column)
    plt.xlabel(column)
    plt.ylabel("Frequency")
    plt.show()


# Boxplots for numerical columns
for column in numeric_columns:
    plt.figure(figsize=(7, 4))
    sns.boxplot(x=df[column])
    plt.title("Boxplot of " + column)
    plt.xlabel(column)
    plt.show()


# Outcome distribution
if "Outcome" in df.columns:
    plt.figure(figsize=(6, 4))
    sns.countplot(x="Outcome", data=df)
    plt.title("Diabetes Outcome Distribution")
    plt.xlabel("Outcome")
    plt.ylabel("Count")
    plt.show()


# ------------------------------------------------------------
# 5. BI-VARIATE ANALYSIS
# ------------------------------------------------------------

# Glucose vs Outcome
if "Glucose" in df.columns and "Outcome" in df.columns:
    plt.figure(figsize=(7, 5))
    sns.boxplot(
        x="Outcome",
        y="Glucose",
        data=df
    )
    plt.title("Glucose vs Diabetes Outcome")
    plt.show()


# BMI vs Outcome
if "BMI" in df.columns and "Outcome" in df.columns:
    plt.figure(figsize=(7, 5))
    sns.boxplot(
        x="Outcome",
        y="BMI",
        data=df
    )
    plt.title("BMI vs Diabetes Outcome")
    plt.show()


# Age vs Outcome
if "Age" in df.columns and "Outcome" in df.columns:
    plt.figure(figsize=(7, 5))
    sns.boxplot(
        x="Outcome",
        y="Age",
        data=df
    )
    plt.title("Age vs Diabetes Outcome")
    plt.show()


# Glucose vs BMI
if "Glucose" in df.columns and "BMI" in df.columns:
    plt.figure(figsize=(8, 5))
    sns.scatterplot(
        x="Glucose",
        y="BMI",
        hue="Outcome",
        data=df
    )
    plt.title("Glucose vs BMI")
    plt.show()


# Correlation heatmap
plt.figure(figsize=(10, 7))

sns.heatmap(
    df.corr(numeric_only=True),
    annot=True,
    cmap="coolwarm"
)

plt.title("Correlation Heatmap")
plt.show()


# Pairplot
sns.pairplot(
    df,
    hue="Outcome"
)

plt.show()


