import pandas as pd
import numpy as np

from sklearn.impute import SimpleImputer
from sklearn.preprocessing import OneHotEncoder, StandardScaler

# Load dataset
df = pd.read_csv("melb_data.csv")

# Handle inappropriate data
df = df.replace([np.inf, -np.inf], np.nan)
df = df.drop_duplicates()

# Separate numerical and categorical columns
numeric_columns = df.select_dtypes(include=np.number).columns
categorical_columns = df.select_dtypes(exclude=np.number).columns

# Handle missing numerical data
num_imputer = SimpleImputer(strategy="median")

df[numeric_columns] = num_imputer.fit_transform(
    df[numeric_columns]
)

# Handle missing categorical data
cat_imputer = SimpleImputer(strategy="most_frequent")

df[categorical_columns] = cat_imputer.fit_transform(
    df[categorical_columns]
)

# Handle categorical data using One Hot Encoding
encoder = OneHotEncoder(
    handle_unknown="ignore",
    sparse_output=False
)

encoded = encoder.fit_transform(
    df[categorical_columns]
)

encoded_columns = encoder.get_feature_names_out(
    categorical_columns
)

encoded_df = pd.DataFrame(
    encoded,
    columns=encoded_columns,
    index=df.index
)

# Remove original categorical columns
df = df.drop(columns=categorical_columns)

# Add encoded columns
df = pd.concat([df, encoded_df], axis=1)

# Standardize numerical columns
scaler = StandardScaler()

df[numeric_columns] = scaler.fit_transform(
    df[numeric_columns]
)

print("Preprocessed Dataset:")
print(df.head())

print("\nShape:")
print(df.shape)

print("\nMissing Values:")
print(df.isnull().sum().sum())
