
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns


# ============================================================
# ASSIGNMENT 1
# MALL CUSTOMERS DATASET
# Perform Exploratory Data Analysis
# ============================================================

print("\n" + "=" * 60)
print("ASSIGNMENT 1 - MALL CUSTOMERS")
print("=" * 60)

df = pd.read_csv("Mall_Customers.csv")

print("\nFirst 5 rows:")
print(df.head())

print("\nLast 5 rows:")
print(df.tail())

print("\nDataset Information:")
print(df.info())

print("\nStatistical Summary:")
print(df.describe())

print("\nMissing Values:")
print(df.isnull().sum())

# Remove duplicate rows
df = df.drop_duplicates()

# Handle missing values
numeric_columns = df.select_dtypes(include=np.number).columns

for column in numeric_columns:
    df[column] = df[column].fillna(df[column].median())

categorical_columns = df.select_dtypes(exclude=np.number).columns

for column in categorical_columns:
    df[column] = df[column].fillna(df[column].mode()[0])


# -------------------------
# UNIVARIATE ANALYSIS
# -------------------------

# Gender distribution
if "Gender" in df.columns:
    plt.figure(figsize=(6, 4))
    sns.countplot(x="Gender", data=df)
    plt.title("Gender Distribution")
    plt.xlabel("Gender")
    plt.ylabel("Count")
    plt.show()


# Age distribution
if "Age" in df.columns:
    plt.figure(figsize=(7, 4))
    sns.histplot(df["Age"], bins=10, kde=True)
    plt.title("Age Distribution")
    plt.xlabel("Age")
    plt.ylabel("Frequency")
    plt.show()


# Annual Income distribution
if "Annual Income (k$)" in df.columns:
    plt.figure(figsize=(7, 4))
    sns.histplot(df["Annual Income (k$)"], bins=10, kde=True)
    plt.title("Annual Income Distribution")
    plt.xlabel("Annual Income (k$)")
    plt.ylabel("Frequency")
    plt.show()


# Spending Score distribution
if "Spending Score (1-100)" in df.columns:
    plt.figure(figsize=(7, 4))
    sns.histplot(df["Spending Score (1-100)"], bins=10, kde=True)
    plt.title("Spending Score Distribution")
    plt.xlabel("Spending Score")
    plt.ylabel("Frequency")
    plt.show()


# -------------------------
# BIVARIATE ANALYSIS
# -------------------------

# Age vs Spending Score
if "Age" in df.columns and "Spending Score (1-100)" in df.columns:
    plt.figure(figsize=(8, 5))
    sns.scatterplot(
        data=df,
        x="Age",
        y="Spending Score (1-100)",
        hue="Gender" if "Gender" in df.columns else None
    )
    plt.title("Age vs Spending Score")
    plt.show()


# Annual Income vs Spending Score
if "Annual Income (k$)" in df.columns and "Spending Score (1-100)" in df.columns:
    plt.figure(figsize=(8, 5))
    sns.scatterplot(
        data=df,
        x="Annual Income (k$)",
        y="Spending Score (1-100)",
        hue="Gender" if "Gender" in df.columns else None
    )
    plt.title("Annual Income vs Spending Score")
    plt.show()


# Correlation heatmap
plt.figure(figsize=(8, 6))
sns.heatmap(
    df.corr(numeric_only=True),
    annot=True,
    cmap="coolwarm"
)
plt.title("Correlation Heatmap")
plt.show()


# Pairplot
sns.pairplot(df)
plt.show()


# ============================================================
# ASSIGNMENT 2
# SALARY DATASET
# Perform Exploratory Data Analysis
# ============================================================

print("\n" + "=" * 60)
print("ASSIGNMENT 2 - SALARY DATA")
print("=" * 60)

# Try common filename formats
try:
    salary = pd.read_csv("salary_data.csv")
except FileNotFoundError:
    try:
        salary = pd.read_csv("Salary_Data.csv")
    except FileNotFoundError:
        salary = pd.read_csv("Salary_Data")

print("\nFirst 5 rows:")
print(salary.head())

print("\nLast 5 rows:")
print(salary.tail())

print("\nDataset Information:")
print(salary.info())

print("\nStatistical Summary:")
print(salary.describe())

print("\nMissing Values:")
print(salary.isnull().sum())

# Remove duplicate rows
salary = salary.drop_duplicates()

# Handle missing numerical values
numeric_columns = salary.select_dtypes(include=np.number).columns

for column in numeric_columns:
    salary[column] = salary[column].fillna(salary[column].median())


# -------------------------
# UNIVARIATE ANALYSIS
# -------------------------

for column in numeric_columns:

    plt.figure(figsize=(7, 4))

    sns.histplot(
        salary[column],
        bins=10,
        kde=True
    )

    plt.title("Distribution of " + column)
    plt.xlabel(column)
    plt.ylabel("Frequency")
    plt.show()


# Boxplots
for column in numeric_columns:

    plt.figure(figsize=(6, 4))

    sns.boxplot(
        x=salary[column]
    )

    plt.title("Boxplot of " + column)
    plt.xlabel(column)
    plt.show()


# -------------------------
# BIVARIATE ANALYSIS
# -------------------------

# Automatically identify Experience and Salary columns
experience_column = None
salary_column = None

for column in salary.columns:

    if "experience" in column.lower():
        experience_column = column

    if "salary" in column.lower():
        salary_column = column


# If names are different, use first two numerical columns
if experience_column is None and len(numeric_columns) >= 1:
    experience_column = numeric_columns[0]

if salary_column is None and len(numeric_columns) >= 2:
    salary_column = numeric_columns[1]


# Experience vs Salary
if experience_column and salary_column:

    plt.figure(figsize=(8, 5))

    sns.scatterplot(
        data=salary,
        x=experience_column,
        y=salary_column
    )

    plt.title("Experience vs Salary")
    plt.xlabel(experience_column)
    plt.ylabel(salary_column)
    plt.show()


# Regression plot
if experience_column and salary_column:

    plt.figure(figsize=(8, 5))

    sns.regplot(
        data=salary,
        x=experience_column,
        y=salary_column
    )

    plt.title("Regression Plot - Experience vs Salary")
    plt.show()


# Correlation heatmap
plt.figure(figsize=(7, 5))

sns.heatmap(
    salary.corr(numeric_only=True),
    annot=True,
    cmap="coolwarm"
)

plt.title("Correlation Heatmap")
plt.show()


